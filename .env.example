# Storage: JSON files under this folder (no DB server needed) — see
# app/db/json_store.py. Only change this if you want the data files
# somewhere else.
DATA_DIR=data/db

# aisstream.io
AISSTREAM_API_KEY=410e147f18fdafb080ffba55594b135042abee73
AISSTREAM_URL=wss://stream.aisstream.io/v0/stream

# AOI bounding box: [[lat_min, lon_min], [lat_max, lon_max]]
AOI_BOUNDING_BOX_LAT_MIN=17.5
AOI_BOUNDING_BOX_LON_MIN=70.5
AOI_BOUNDING_BOX_LAT_MAX=19.5
AOI_BOUNDING_BOX_LON_MAX=73.0

# Copernicus Data Space (Sentinel Hub)
COPERNICUS_CLIENT_ID=your_client_id
COPERNICUS_CLIENT_SECRET=your_client_secret

# Open-Meteo (no key required, base URL only)
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# Model paths
UNET_WEIGHTS_PATH=app/ml/models/unet_weights.pt
LOOKALIKE_MODEL_PATH=app/ml/models/lookalike_rf.joblib

# Thresholds
CONFIRM_SCORE_THRESHOLD=0.7
ANOMALY_WINDOW_MINUTES=60
AIS_CORRELATION_RADIUS_KM=5.0
AIS_CORRELATION_WINDOW_HOURS=6.0

# ICG / MRCC notification (mock endpoint for prototype)
ICG_ALERT_WEBHOOK_URL=
